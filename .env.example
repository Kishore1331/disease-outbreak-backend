# Epidemiology Surveillance Platform Environment Example
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Optional External Weather API Key (Open-Meteo works without key)
WEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=900

# Geographic Center (Coimbatore Municipal Corporation)
DEFAULT_DISTRICT=Coimbatore
DEFAULT_LATITUDE=11.0168
DEFAULT_LONGITUDE=76.9558

# SMS Alert Gateway Configuration (Placeholders only)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
FAST2SMS_API_KEY=your_fast2sms_api_key_here
