# ==============================================================================
# EPIDEMIOLOGY — BACKEND CONFIGURATION TEMPLATE (.env.example)
#
# Copy this file to backend/.env and populate with your credentials.
# SECURITY NOTICE: Never commit real credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Geographic Center (Coimbatore Municipal Corporation)
DEFAULT_DISTRICT=Coimbatore
DEFAULT_LATITUDE=11.0168
DEFAULT_LONGITUDE=76.9558

# External Weather API (Open-Meteo free tier requires no API key)
WEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=900

# ==============================================================================
# CELLULAR SMS ALERT GATEWAY CONFIGURATION
# Configure either Option A (Twilio) OR Option B (Fast2SMS) for real SMS alerts.
# Delivery statuses reported: SENT, FAILED, or GATEWAY_NOT_CONFIGURED.
# ==============================================================================

# Option A: Twilio SMS Gateway (International & Indian standard)
# Sign up at: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Option B: Fast2SMS Gateway (Indian Cellular Numbers)
# Sign up at: https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_ROUTE=q

# ==============================================================================
# MUNICIPAL EPIDEMIOLOGICAL ALERT SETTINGS
# ==============================================================================
# High-risk threshold triggers: composite risk score >= 65.0 or cases >= 24
HIGH_RISK_CASE_THRESHOLD=24
HIGH_RISK_COMPOSITE_THRESHOLD=65.0
ALERT_COOLDOWN_HOURS=12

# Registered Municipal Officer Defaults (Can also be set in Admin UI)
DEFAULT_OFFICER_NAME=Kishore
DEFAULT_OFFICER_PHONE=+919345791866
DEFAULT_OFFICER_EMAIL=24121027@drngpit.ac.in
